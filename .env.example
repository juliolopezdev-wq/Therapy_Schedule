DATABASE_URL=
TURSO_AUTH_TOKEN=

# IANA timezone the server computes "today"/day boundaries in (session queries, digests, etc).
# Defaults to UTC if unset -- set this to your facility's zone, not the server's.
TZ=America/New_York

# Server-only, base64-encoded 32-byte key. Back up separately from the database.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
# Only set false temporarily when coordinating rollout with an older deployed app.
MESSAGE_ENCRYPTION_ENABLED=true
MESSAGE_ENCRYPTION_ALLOW_LEGACY_READS=false

# Auth: bootstrap admin email (can request a login link before any invite exists) and the
# base URL used to build magic-link login links in emails.
OWNER_EMAIL=
APP_URL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set true only after approving the remote endpoint for patient data, including applicable BAA/retention controls.
AI_REMOTE_APPROVED=false
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=

# SMTP -- used for magic-link login emails and assignment/digest notifications. Any generic
# SMTP provider works (Gmail app password, SES SMTP, SendGrid SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated recipient list for the at-risk digest email.
DIGEST_NOTIFICATION_EMAILS=
